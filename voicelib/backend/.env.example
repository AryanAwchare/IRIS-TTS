# ── 1. Database (PostgreSQL Connection String) ───────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── 2. Storage (Leave empty for automatic local disk fallback on localhost) ──────
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=local
STORAGE_SECRET_KEY=local
STORAGE_BUCKET_NAME=voicelib
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=

# ── 3. Auth (Change in production) ──────────────────────────────────
JWT_SECRET_KEY=voicelib-localhost-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 4. Dev Settings & Constraints ────────────────────────────────────────────────
VOICELIB_USE_MOCK_TTS=false
TTS_ENGINE=gpt-sovits-v3
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
COLAB_GPU_API_URL=https://your-ngrok-tunnel-url.ngrok-free.dev
VOICE_SIMILARITY_THRESHOLD=60.0

MIN_SAMPLE_DURATION_SECONDS=3.0
MAX_SAMPLE_DURATION_SECONDS=120
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_AUDIO_FORMATS=["audio/wav","audio/mpeg","audio/mp3","audio/x-mp3","audio/mpeg3","audio/x-mpeg-3","audio/x-mpeg","audio/ogg","audio/flac","audio/x-wav","audio/wave","audio/mp4","audio/m4a","audio/x-m4a","audio/aac","application/octet-stream","binary/octet-stream"]

# ── 5. Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
