# Database
DATABASE_URL=postgresql+asyncpg://voicelib:voicelib@postgres:5432/voicelib

# Object Storage (MinIO for local dev)
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=voicelib
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=

# Auth
JWT_SECRET_KEY=change-me-in-production-use-32-random-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=20971520
MIN_SAMPLE_DURATION_SECONDS=6
MAX_SAMPLE_DURATION_SECONDS=120
ALLOWED_AUDIO_FORMATS=["audio/wav","audio/mpeg","audio/mp3","audio/x-mp3","audio/mpeg3","audio/x-mpeg-3","audio/x-mpeg","audio/ogg","audio/flac","audio/x-wav","audio/wave","audio/mp4","audio/m4a","audio/x-m4a","audio/aac","application/octet-stream","binary/octet-stream"]

# TTS Engine Configuration ("gpt-sovits-v3" | "pocket-tts" | "zonos-expressive")
TTS_ENGINE=gpt-sovits-v3
VOICELIB_USE_MOCK_TTS=false
GPT_SOVITS_MODEL_PATH=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
