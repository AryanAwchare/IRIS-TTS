## Cell 6 — FastAPI App Definition

```python
import asyncio
from fastapi import FastAPI, UploadFile, File, Form
from fastapi.responses import Response
from typing import Optional

app = FastAPI(title="VoiceLib Chatterbox GPU Server")
_GPU_LOCK = asyncio.Lock()

@app.get("/")
@app.get("/health")
def health():
    return {
        "status":          "healthy",
        "engine":          "chatterbox-tts",
        "model":           "chatterbox-tts",
        "cuda":            torch.cuda.is_available(),
        "gpu":             torch.cuda.get_device_name(0) if torch.cuda.is_available() else "cpu",
        "torch":           torch.__version__,
        "sample_rate":     getattr(_MODEL, "sr", 32000) if _MODEL else 32000,
        "emotion_presets": list(EMOTION_PRESETS.keys()),
    }

@app.post("/tts")
async def tts_endpoint(
    text:            str             = Form(...),
    reference_audio: UploadFile      = File(...),
    emotion:         str             = Form("neutral"),
    cfg_weight:      Optional[float] = Form(None),
    exaggeration:    Optional[float] = Form(None),
    speed:           float           = Form(1.0),
    pitch:           float           = Form(0.0),
    language:        str             = Form("en"),
):
    t0 = time.perf_counter()
    async with _GPU_LOCK:
        model = get_model()
        if model is None:
            return Response(content=b"Model not loaded.", status_code=503, media_type="text/plain")
        try:
            gen_sr = getattr(model, "sr", 32000)

            raw_bytes = await reference_audio.read()
            cleaned_bytes, _, _ = clean_audio(raw_bytes, target_sr=gen_sr)
            ref_path = select_best_segment(cleaned_bytes, target_duration=10.0)

            clean_text = text.strip() or "Hello."
            for pat, rep in TAG_REPLACEMENTS.items():
                clean_text = re.sub(pat, rep, clean_text, flags=re.IGNORECASE)

            ne = (emotion or "neutral").lower().strip()
            exag_def, cfg_def = EMOTION_PRESETS.get(ne, EMOTION_PRESETS["neutral"])
            active_cfg  = float(np.clip(cfg_weight  if cfg_weight  is not None else cfg_def,  0.20, 0.90))
            active_exag = float(np.clip(exaggeration if exaggeration is not None else exag_def, 0.00, 0.50))

            try:
                if len(clean_text) > 80 or re.search(r"[,;]", clean_text):
                    sentences = split_sentences(clean_text, min_chars=35)
                    chunks, fade = [], int(gen_sr * 0.005)
                    for i, sent in enumerate(sentences):
                        s = sent.strip()
                        if not s.endswith((".", "!", "?", ";", ",")): s += "."
                        with torch.inference_mode():
                            wav_t = model.generate(s, audio_prompt_path=ref_path,
                                                   cfg_weight=active_cfg, exaggeration=active_exag)
                        chunk = wav_t.squeeze().detach().cpu().numpy().astype(np.float32)
                        if len(chunk) > fade*2:
                            chunk[:fade]  *= 0.5*(1.0-np.cos(np.pi*np.linspace(0,1,fade)))
                            chunk[-fade:] *= 0.5*(1.0+np.cos(np.pi*np.linspace(0,1,fade)))
                        chunks.append(chunk)
                        if i < len(sentences)-1:
                            pause = 220.0 if s.endswith((".", "!")) else 160.0
                            chunks.append(np.zeros(int(gen_sr*pause/1000), dtype=np.float32))
                    gen_np = np.concatenate(chunks).astype(np.float32)
                else:
                    with torch.inference_mode():
                        wav_t = model.generate(clean_text, audio_prompt_path=ref_path,
                                               cfg_weight=active_cfg, exaggeration=active_exag)
                    gen_np = wav_t.squeeze().detach().cpu().numpy().astype(np.float32)
            finally:
                try:
                    if ref_path and os.path.exists(ref_path): os.unlink(ref_path)
                except Exception: pass

            if len(gen_np) > gen_sr*0.5:
                yt, _ = librosa.effects.trim(gen_np, top_db=38)
                if len(yt) > gen_sr*0.3: gen_np = yt
            if abs(pitch) > 0.05:
                try: gen_np = librosa.effects.pitch_shift(gen_np, sr=gen_sr, n_steps=pitch).astype(np.float32)
                except Exception: pass
            if abs(speed-1.0) > 0.03 and 0.5 <= speed <= 2.0:
                gen_np = pitch_preserving_stretch(gen_np, rate=speed)
            gen_np = master_audio(gen_np, sr=gen_sr)
            if torch.cuda.is_available(): torch.cuda.empty_cache()

            buf = io.BytesIO()
            sf.write(buf, gen_np, gen_sr, format="WAV", subtype="PCM_16")
            latency = time.perf_counter() - t0
            print(f"⚡ {ne} | {speed:.2f}x | {pitch:+.1f}st | {len(clean_text)} chars | {latency:.2f}s")

            return Response(content=buf.getvalue(), media_type="audio/wav", headers={
                "X-Model": "chatterbox-tts", "X-Sample-Rate": str(gen_sr),
                "X-Latency-Seconds": f"{latency:.2f}", "X-Resolved-Emotion": ne,
                "X-Resolved-CFG": f"{active_cfg:.2f}", "X-Resolved-Exaggeration": f"{active_exag:.2f}",
                "ngrok-skip-browser-warning": "true",
            })
        except Exception as exc:
            tb = traceback.format_exc()
            print(f"❌ {exc}")
            return Response(content=f"Error: {exc}\n{tb}".encode(), status_code=500, media_type="text/plain")

